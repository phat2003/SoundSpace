{
  "ConnectionStrings": {
    "DefaultConnection": "[filled in for each different environment]"
  },
  "JwtTokenSettings": {
    "Issuer": "https://soundspace.local",
    "ExpireInHours": 24,
    "RefreshTokenExpireInDays": 30
  },
  "R2StorageSettings": {
    "AccountId": "[filled in for each different environment]",
    "AudioBucketName": "soundspace",
    "ImageBucketName": "soundspace-images",
    "ImagePublicUrl": "[filled in for each different environment]"
  },
  "MediaSettings": {
    "AllowAudioFileTypes": ".mp3",
    "AllowImageFileTypes": ".jpg,.jpeg,.png,.webp",
    "MaxAudioSizeInMB": 20,
    "MaxImageSizeInMB": 5
  },
  "AllowedOrigins": "[filled in for each different environment]",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
